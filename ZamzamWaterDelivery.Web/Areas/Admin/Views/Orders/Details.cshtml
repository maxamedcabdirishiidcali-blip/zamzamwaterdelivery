@model AdminOrderDetailsViewModel
@{
    var o = Model.Order;
    ViewData["Title"] = $"Order {o.OrderNumber}";
    var canAssign = OrderStatusRules.CanAssignDriver(o.Status);
    var canCancel = OrderStatusRules.CanBeCancelled(o.Status);
}
<a asp-action="Index" class="btn btn-link text-decoration-none ps-0"><i class="bi bi-arrow-left me-1"></i>Orders</a>
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Order @o.OrderNumber</h1>
        <span class="text-muted small">Placed @Ui.When(o.OrderDate)@(o.UpdatedAt is null ? "" : $" · Updated {Ui.When(o.UpdatedAt)}")</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (o.Status == OrderStatus.Pending)
        {
            <form asp-action="Confirm" asp-route-id="@o.Id" method="post"><button class="btn btn-success" data-loading="Confirming..."><i class="bi bi-check2-circle me-1"></i>Confirm order</button></form>
        }
        @foreach (var next in Model.NextStatuses.Where(s => s != OrderStatus.Confirmed || o.Status != OrderStatus.Pending))
        {
            <form asp-action="ChangeStatus" asp-route-id="@o.Id" method="post" data-confirm="Mark order as @next.ToDisplayName()?">
                <input type="hidden" name="Status" value="@next" />
                <button class="btn btn-outline-primary"><i class="bi @Ui.Icon(next) me-1"></i>@next.ToDisplayName()</button>
            </form>
        }
        @if (canCancel)
        {
            <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal"><i class="bi bi-x-circle me-1"></i>Cancel</button>
        }
    </div>
</div>

<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><partial name="_OrderProgress" model="o" /></div></div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-3"><h6 class="fw-semibold mb-0">Items</h6></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th>Product</th><th class="text-center">Qty</th><th class="text-end">Unit price</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                        @foreach (var i in o.Items)
                        {
                            <tr><td>@i.ProductName</td><td class="text-center">@i.Quantity</td><td class="text-end">@Ui.Money(i.UnitPrice)</td><td class="text-end">@Ui.Money(i.LineTotal)</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="3" class="text-end text-muted">Subtotal</td><td class="text-end">@Ui.Money(o.SubTotal)</td></tr>
                        <tr><td colspan="3" class="text-end text-muted">Delivery fee</td><td class="text-end">@Ui.Money(o.DeliveryFee)</td></tr>
                        <tr class="fw-bold"><td colspan="3" class="text-end">Total</td><td class="text-end text-primary">@Ui.Money(o.Total)</td></tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-semibold mb-0">Delivery</h6>
                @if (o.Delivery is not null)
                {
                    <a asp-controller="Deliveries" asp-action="Edit" asp-route-id="@o.Delivery.Id" class="small">Edit delivery</a>
                }
            </div>
            <div class="card-body">
                @if (o.Delivery is { } d)
                {
                    <div class="row g-3 small">
                        <div class="col-md-6"><span class="text-muted d-block">Status</span><span class="badge rounded-pill @Ui.Badge(d.Status)">@d.Status.ToDisplayName()</span></div>
                        <div class="col-md-6"><span class="text-muted d-block">Driver</span>@(d.DriverName ?? "Not assigned") @(d.DriverPhone is null ? "" : $"· {d.DriverPhone}")</div>
                        <div class="col-md-6"><span class="text-muted d-block">Scheduled</span>@Ui.Date(d.DeliveryDate) · @(d.DeliveryTime ?? "-")</div>
                        <div class="col-md-6"><span class="text-muted d-block">Delivery fee</span>@Ui.Money(d.DeliveryFee)</div>
                        <div class="col-md-3"><span class="text-muted d-block">Assigned</span>@Ui.When(d.AssignedAt)</div>
                        <div class="col-md-3"><span class="text-muted d-block">Accepted</span>@Ui.When(d.AcceptedAt)</div>
                        <div class="col-md-3"><span class="text-muted d-block">Picked up</span>@Ui.When(d.PickedUpAt)</div>
                        <div class="col-md-3"><span class="text-muted d-block">Delivered</span>@Ui.When(d.DeliveredAt)</div>
                        @if (!string.IsNullOrEmpty(d.Notes))
                        {
                            <div class="col-12"><span class="text-muted d-block">Delivery notes</span>@d.Notes</div>
                        }
                    </div>
                }
                @if (canAssign)
                {
                    <hr />
                    <form asp-action="AssignDriver" asp-route-id="@o.Id" method="post" class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label small" for="DriverId">@(o.Delivery?.DriverId is null ? "Assign driver" : "Reassign driver")</label>
                            <select id="DriverId" name="DriverId" class="form-select" asp-items="Model.Drivers" required><option value="">Select an available driver...</option></select>
                        </div>
                        <div class="col-md-4 d-grid"><button class="btn btn-primary" data-loading="Assigning..."><i class="bi bi-person-check me-1"></i>@(o.Delivery?.DriverId is null ? "Assign" : "Reassign")</button></div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-person text-primary me-1"></i>Customer</h6>
                <p class="mb-1 fw-semibold"><a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId">@o.CustomerName</a></p>
                <p class="mb-1 small"><a href="tel:@Ui.Tel(o.PhoneNumber)"><i class="bi bi-telephone me-1"></i>@o.PhoneNumber</a></p>
                <p class="mb-1 small text-muted">@o.CustomerEmail</p>
                <p class="mb-0 small"><i class="bi bi-geo-alt me-1"></i>@o.DeliveryAddress, @o.City</p>
                <p class="mt-2 mb-0 small text-muted">Preferred: @Ui.Date(o.PreferredDeliveryDate) · @o.PreferredTimeSlot</p>
                @if (!string.IsNullOrEmpty(o.Notes))
                {
                    <div class="alert alert-info small mt-3 mb-0 py-2"><i class="bi bi-chat-left-text me-1"></i>@o.Notes</div>
                }
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-wallet2 text-primary me-1"></i>Payment</h6>
                @if (o.Payment is { } p)
                {
                    <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Method</span><span>@p.Method.ToDisplayName()</span></div>
                    <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Amount</span><span>@Ui.Money(p.Amount)</span></div>
                    <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Status</span><span class="badge rounded-pill @Ui.Badge(p.Status)">@p.Status</span></div>
                    <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Reference</span><span>@(p.TransactionReference ?? "-")</span></div>
                    <div class="d-flex justify-content-between small"><span class="text-muted">Paid on</span><span>@Ui.When(p.PaymentDate)</span></div>
                }
            </div>
        </div>
    </div>
</div>

@if (canCancel)
{
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content border-0" asp-action="Cancel" asp-route-id="@o.Id" method="post">
                <div class="modal-header border-0"><h5 class="modal-title" id="cancelTitle">Cancel order @o.OrderNumber</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <p class="small text-muted">Stock will be restored and the customer notified.</p>
                    <label for="Reason" class="form-label">Reason</label>
                    <textarea id="Reason" name="Reason" class="form-control" rows="2" maxlength="300" placeholder="e.g. Customer unreachable"></textarea>
                </div>
                <div class="modal-footer border-0"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button><button class="btn btn-danger" data-loading="Cancelling...">Cancel order</button></div>
            </form>
        </div>
    </div>
}
