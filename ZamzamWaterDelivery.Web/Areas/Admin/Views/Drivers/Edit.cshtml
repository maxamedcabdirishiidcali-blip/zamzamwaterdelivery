@model DriverUpdateDto
@{
    ViewData["Title"] = "Edit Driver";
    var id = ViewData["DriverId"];
}
<a asp-action="Details" asp-route-id="@id" class="btn btn-link text-decoration-none ps-0"><i class="bi bi-arrow-left me-1"></i>Driver</a>
<h1 class="h3 fw-bold mb-4">Edit Driver</h1>
<form asp-action="Edit" asp-route-id="@id" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 row g-3">
            <partial name="_DriverFields" model="Model" />
            <div class="col-12"><button class="btn btn-primary" data-loading="Saving..."><i class="bi bi-check2 me-1"></i>Save changes</button></div>
        </div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
