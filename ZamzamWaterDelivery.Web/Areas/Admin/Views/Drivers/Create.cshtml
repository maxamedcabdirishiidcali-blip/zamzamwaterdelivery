@model DriverCreateDto
@{
    ViewData["Title"] = "Add Driver";
}
<a asp-action="Index" class="btn btn-link text-decoration-none ps-0"><i class="bi bi-arrow-left me-1"></i>Drivers</a>
<h1 class="h3 fw-bold mb-4">Add Driver</h1>
<form asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 row g-3">
            <partial name="_DriverFields" model="Model" />
            <div class="col-12"><hr /><h6 class="fw-semibold">Login password</h6></div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="col-12"><button class="btn btn-primary" data-loading="Creating..."><i class="bi bi-person-plus me-1"></i>Create driver</button></div>
        </div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
