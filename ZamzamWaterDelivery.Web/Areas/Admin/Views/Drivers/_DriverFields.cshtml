@model DriverUpdateDto
<div class="col-md-6">
    <label asp-for="FullName" class="form-label"></label>
    <input asp-for="FullName" class="form-control" />
    <span asp-validation-for="FullName" class="text-danger small"></span>
</div>
<div class="col-md-6">
    <label asp-for="PhoneNumber" class="form-label"></label>
    <input asp-for="PhoneNumber" class="form-control" />
    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
</div>
<div class="col-md-6">
    <label asp-for="Email" class="form-label">Email (login)</label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger small"></span>
</div>
<div class="col-md-6">
    <label asp-for="Status" class="form-label"></label>
    <select asp-for="Status" class="form-select" asp-items="Ui.EnumOptions<DriverStatus>(Model.Status)"></select>
</div>
<div class="col-md-4">
    <label asp-for="VehicleType" class="form-label"></label>
    <input asp-for="VehicleType" class="form-control" list="vehicleTypes" />
    <datalist id="vehicleTypes"><option value="Pickup Truck"></option><option value="Water Truck"></option><option value="Bajaj (Tuk-tuk)"></option><option value="Motorcycle"></option><option value="Van"></option></datalist>
    <span asp-validation-for="VehicleType" class="text-danger small"></span>
</div>
<div class="col-md-4">
    <label asp-for="VehicleNumber" class="form-label"></label>
    <input asp-for="VehicleNumber" class="form-control" />
    <span asp-validation-for="VehicleNumber" class="text-danger small"></span>
</div>
<div class="col-md-4">
    <label asp-for="LicenseNumber" class="form-label"></label>
    <input asp-for="LicenseNumber" class="form-control" />
    <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
</div>
