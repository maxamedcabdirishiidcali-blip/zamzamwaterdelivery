<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var area = ViewContext.RouteData.Values["area"]?.ToString();
        string Active(string name) => area == "Admin" && controller == name ? "active" : "";
        var menu = new (string Controller, string Icon, string Label)[]
        {
            ("Dashboard", "bi-speedometer2", "Dashboard"),
            ("Orders", "bi-receipt", "Orders"),
            ("Deliveries", "bi-truck", "Deliveries"),
            ("Products", "bi-droplet", "Products"),
            ("Categories", "bi-tags", "Categories"),
            ("Customers", "bi-people", "Customers"),
            ("Drivers", "bi-person-badge", "Drivers"),
            ("Payments", "bi-wallet2", "Payments"),
            ("Reports", "bi-bar-chart-line", "Reports")
        };
    }
    <div class="offcanvas-lg offcanvas-start admin-sidebar" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-white" id="adminSidebarLabel">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-0">
            <a class="sidebar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <img src="~/images/logo-mark.svg" alt="" width="36" height="36" />
                <span>Zamzam <small class="d-block">Admin Panel</small></span>
            </a>
            <nav class="nav flex-column px-2 py-3 gap-1">
                @foreach (var (c, icon, label) in menu)
                {
                    <a class="nav-link @Active(c)" asp-area="Admin" asp-controller="@c" asp-action="Index"><i class="bi @icon"></i>@label</a>
                }
            </nav>
            <div class="mt-auto p-3 small">
                <a class="nav-link text-white-50" asp-area="" asp-controller="Home" asp-action="Index" target="_blank"><i class="bi bi-box-arrow-up-right me-2"></i>View website</a>
            </div>
        </div>
    </div>

    <div class="admin-main">
        <header class="admin-topbar d-flex align-items-center justify-content-between px-3 px-lg-4">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open menu"><i class="bi bi-list"></i></button>
                <span class="fw-semibold text-muted d-none d-sm-inline">@ViewData["Title"]</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                @await Component.InvokeAsync("NotificationBell")
                <div class="dropdown">
                    <button class="btn btn-light border rounded-pill dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-person-circle me-1"></i><span class="d-none d-sm-inline">@User.Identity?.Name</span></button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><a class="dropdown-item" asp-area="" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="p-3 p-lg-4">
            @RenderBody()
        </main>
    </div>

    <partial name="_Alerts" />
    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
