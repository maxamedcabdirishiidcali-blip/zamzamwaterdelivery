@model PageHeader
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0">@Model.Title</h1>
        @if (Model.Subtitle is not null)
        {
            <small class="text-muted">@Model.Subtitle</small>
        }
    </div>
    @if (Model.AddUrl is not null)
    {
        <a href="@Model.AddUrl" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@(Model.AddLabel ?? "Add")</a>
    }
</div>
