@model RegisterDto
@{
    ViewData["Title"] = "Add Customer";
}
<a asp-action="Index" class="btn btn-link text-decoration-none ps-0"><i class="bi bi-arrow-left me-1"></i>Customers</a>
<h1 class="h3 fw-bold mb-4">Add Customer</h1>
<form asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autofocus />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+252 90 7xxxxxx" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Email" class="form-label">Email (login)</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="AddressLine" class="form-label"></label>
                <input asp-for="AddressLine" class="form-control" placeholder="House / building, street" />
                <span asp-validation-for="AddressLine" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" placeholder="Garowe" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" placeholder="District / landmark" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>            <div class="col-12">
                <button class="btn btn-primary" data-loading="Saving..."><i class="bi bi-check2 me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-light ms-1">Cancel</a>
            </div>
        </div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
