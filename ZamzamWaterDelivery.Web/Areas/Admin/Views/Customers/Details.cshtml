@model CustomerDetailsDto
@{
    ViewData["Title"] = Model.FullName;
}
<a asp-action="Index" class="btn btn-link text-decoration-none ps-0"><i class="bi bi-arrow-left me-1"></i>Customers</a>
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 text-center">
                <div class="avatar avatar-lg mx-auto mb-3">@Model.FullName[0]</div>
                <h1 class="h5 fw-bold mb-1">@Model.FullName</h1>
                <span class="badge rounded-pill @(Model.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">@(Model.IsActive ? "Active" : "Inactive")</span>
                <ul class="list-unstyled text-start small mt-4 mb-4">
                    <li class="mb-2"><i class="bi bi-envelope text-primary me-2"></i>@Model.Email</li>
                    <li class="mb-2"><i class="bi bi-telephone text-primary me-2"></i><a href="tel:@Ui.Tel(Model.PhoneNumber)">@Model.PhoneNumber</a></li>
                    <li class="mb-2"><i class="bi bi-calendar text-primary me-2"></i>Joined @Ui.Date(Model.CreatedAt)</li>
                    <li><i class="bi bi-clock-history text-primary me-2"></i>Last login @Ui.When(Model.LastLoginAt)</li>
                </ul>
                <div class="d-flex gap-2 mb-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary flex-fill"><i class="bi bi-pencil me-1"></i>Edit</a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex-fill" data-confirm="Delete '@Model.FullName'? Their past orders stay in the reports.">
                        <button class="btn btn-outline-danger w-100"><i class="bi bi-trash me-1"></i>Delete</button>
                    </form>
                </div>
                <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post"
                      data-confirm="@(Model.IsActive ? "Deactivate this account? The customer will be signed out and cannot log in." : "Activate this account?")">
                    <input type="hidden" name="isActive" value="@((!Model.IsActive).ToString().ToLower())" />
                    <button class="btn w-100 @(Model.IsActive ? "btn-outline-danger" : "btn-success")">
                        <i class="bi @(Model.IsActive ? "bi-person-x" : "bi-person-check") me-1"></i>@(Model.IsActive ? "Deactivate account" : "Activate account")
                    </button>
                </form>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h6 class="fw-semibold mb-3">Addresses</h6>
                @foreach (var a in Model.Addresses)
                {
                    <div class="small mb-2"><i class="bi bi-geo-alt text-primary me-1"></i>@a.AddressLine, @a.Location, @a.City @if (a.IsDefault) {<span class="badge bg-primary-subtle text-primary-emphasis ms-1">Default</span>}</div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="row g-3 mb-4">
            <div class="col-6"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Orders</div><div class="fs-4 fw-bold">@Model.OrderCount</div></div></div></div>
            <div class="col-6"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-muted">Total spent (delivered)</div><div class="fs-4 fw-bold text-success">@Ui.Money(Model.TotalSpent)</div></div></div></div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3"><h6 class="fw-semibold mb-0">Order history</h6></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light"><tr><th>Order #</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th></tr></thead>
                    <tbody>
                        @if (Model.Orders.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No orders yet.</td></tr>
                        }
                        @foreach (var o in Model.Orders)
                        {
                            <tr class="clickable-row" data-href="@Url.Action("Details", "Orders", new { id = o.Id })">
                                <td class="fw-semibold">@o.OrderNumber</td><td>@Ui.When(o.OrderDate)</td><td>@o.ItemCount</td><td>@Ui.Money(o.Total)</td>
                                <td><span class="badge rounded-pill @Ui.Badge(o.Status)">@o.Status.ToDisplayName()</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
