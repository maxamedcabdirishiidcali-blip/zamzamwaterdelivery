@model DeliveryEditViewModel
@{
    var d = Model.Delivery;
    ViewData["Title"] = $"Delivery {d.OrderNumber}";
}
<a asp-action="Index" class="btn btn-link text-decoration-none ps-0"><i class="bi bi-arrow-left me-1"></i>Deliveries</a>
<h1 class="h3 fw-bold mb-4">Delivery for order <a asp-controller="Orders" asp-action="Details" asp-route-id="@d.OrderId">@d.OrderNumber</a></h1>
<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Edit" asp-route-id="@d.Id" method="post" class="card border-0 shadow-sm" novalidate>
            <div class="card-body p-4 row g-3">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="col-12">
                    <label asp-for="Form.DriverId" class="form-label">Driver @(d.DriverId is null ? "" : "(select another to reassign)")</label>
                    <select asp-for="Form.DriverId" class="form-select" asp-items="Model.Drivers"><option value="">Unassigned</option></select>
                    @if (d.DriverName is not null && !Model.Drivers.Any(x => x.Selected))
                    {
                        <small class="text-muted">Current: @d.DriverName (currently not assignable)</small>
                    }
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.DeliveryDate" class="form-label"></label>
                    <input asp-for="Form.DeliveryDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.DeliveryTime" class="form-label"></label>
                    <select asp-for="Form.DeliveryTime" class="form-select" asp-items="@(new SelectList(Model.TimeSlots, Model.Form.DeliveryTime))"><option value="">-</option></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.DeliveryFee" class="form-label"></label>
                    <div class="input-group"><span class="input-group-text">@Company.CurrencySymbol</span><input asp-for="Form.DeliveryFee" type="number" step="0.01" min="0" class="form-control" /></div>
                    <span asp-validation-for="Form.DeliveryFee" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Form.Notes" class="form-label">Notes for the driver</label>
                    <textarea asp-for="Form.Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Form.Notes" class="text-danger small"></span>
                </div>
                <div class="col-12"><button class="btn btn-primary" data-loading="Saving..."><i class="bi bi-check2 me-1"></i>Save delivery</button></div>
            </div>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 small">
                <h6 class="fw-semibold mb-3">Summary</h6>
                <div class="d-flex justify-content-between mb-2"><span class="text-muted">Status</span><span class="badge rounded-pill @Ui.Badge(d.Status)">@d.Status.ToDisplayName()</span></div>
                <div class="d-flex justify-content-between mb-2"><span class="text-muted">Customer</span><span>@d.CustomerName</span></div>
                <div class="d-flex justify-content-between mb-2"><span class="text-muted">Phone</span><a href="tel:@Ui.Tel(d.CustomerPhone)">@d.CustomerPhone</a></div>
                <div class="d-flex justify-content-between mb-2"><span class="text-muted">Address</span><span class="text-end">@d.DeliveryAddress</span></div>
                <div class="d-flex justify-content-between mb-2"><span class="text-muted">Order total</span><span>@Ui.Money(d.OrderTotal)</span></div>
                <hr />
                @foreach (var i in d.Items)
                {
                    <div class="d-flex justify-content-between"><span>@i.Quantity &times; @i.ProductName</span><span>@Ui.Money(i.LineTotal)</span></div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
