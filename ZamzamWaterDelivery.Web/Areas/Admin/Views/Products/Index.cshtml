@model ListViewModel<ProductDto, ProductFilter>
@{
    ViewData["Title"] = "Products";
}
<partial name="_PageHeader" model='new PageHeader("Products", Url.Action("Create"), "Add Product")' />
<partial name="_SearchBar" model="Model.Filter.Search" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Product</th><th class="d-none d-md-table-cell">Category</th><th>Price</th><th>Stock</th><th class="d-none d-sm-table-cell">Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (Model.Result.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">No products found. <a asp-action="Create">Add the first product</a>.</td></tr>
                }
                @foreach (var p in Model.Result.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@(p.ImageUrl ?? "/images/products/bottle-20l.svg")" alt="" width="40" height="40" class="rounded bg-light-blue p-1 object-fit-contain" />
                                <span class="fw-semibold">@p.Name</span>
                            </div>
                        </td>
                        <td class="d-none d-md-table-cell">@p.CategoryName</td>
                        <td>@Ui.Money(p.Price)</td>
                        <td class="@(p.StockQuantity <= 20 ? "text-danger fw-semibold" : "")">@p.StockQuantity</td>
                        <td class="d-none d-sm-table-cell">
                            <span class="badge rounded-pill @(p.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">@(p.IsActive ? "Active" : "Inactive")</span>
                        </td>
                        <td><partial name="_RowActions" model='new RowActions(p.Name, Url.Action("Edit", new { id = p.Id }), Url.Action("Delete", new { id = p.Id }))' /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result)" />
