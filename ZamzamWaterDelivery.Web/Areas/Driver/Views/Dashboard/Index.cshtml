@model DriverDashboardViewModel
@{
    ViewData["Title"] = "My Deliveries";
    var d = Model.Driver;
}
<div class="card border-0 shadow-sm mb-3 driver-hero">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar avatar-lg bg-white text-primary">@d.FullName[0]</div>
            <div class="flex-grow-1">
                <div class="small opacity-75">Welcome back</div>
                <h1 class="h5 fw-bold mb-0">@d.FullName</h1>
                <div class="small opacity-75">@d.VehicleType &middot; @d.VehicleNumber</div>
            </div>
        </div>
        <form asp-action="SetStatus" method="post" class="mt-3">
            <div class="btn-group w-100" role="group" aria-label="Availability">
                @foreach (var s in Enum.GetValues<DriverStatus>())
                {
                    var icon = s switch { DriverStatus.Available => "bi-check-circle", DriverStatus.Busy => "bi-hourglass", _ => "bi-moon" };
                    <button name="status" value="@s" class="btn @(d.Status == s ? "btn-light text-primary fw-semibold" : "btn-outline-light")"><i class="bi @icon me-1"></i>@s</button>
                }
            </div>
        </form>
    </div>
</div>

<div class="row g-2 mb-3 text-center">
    <div class="col-3"><div class="mini-stat"><div class="fs-5 fw-bold">@Model.Stats.AssignedCount</div><small>New</small></div></div>
    <div class="col-3"><div class="mini-stat"><div class="fs-5 fw-bold">@Model.Stats.InProgressCount</div><small>On the way</small></div></div>
    <div class="col-3"><div class="mini-stat"><div class="fs-5 fw-bold">@Model.Stats.DeliveredToday</div><small>Today</small></div></div>
    <div class="col-3"><div class="mini-stat"><div class="fs-6 fw-bold">@Ui.Money(Model.Stats.CashToCollect)</div><small>Cash to collect</small></div></div>
</div>

<ul class="nav nav-pills nav-fill mb-3" role="tablist">
    <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#activeTab" type="button" role="tab">Active (@Model.Active.Count)</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#historyTab" type="button" role="tab">History</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="activeTab" role="tabpanel">
        @if (Model.Active.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-cup-hot"></i><h5>No active deliveries</h5><p class="text-muted small">New assignments will appear here.</p></div>
        }
        @foreach (var x in Model.Active)
        {
            <div class="card border-0 shadow-sm mb-3 delivery-card status-@x.Status.ToString().ToLower()">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="fw-bold">@x.OrderNumber</div>
                            <small class="text-muted">@Ui.Date(x.DeliveryDate) &middot; @(x.DeliveryTime ?? "Any time")</small>
                        </div>
                        <span class="badge rounded-pill @Ui.Badge(x.Status)">@x.Status.ToDisplayName()</span>
                    </div>
                    <div class="mb-1"><i class="bi bi-person text-primary me-2"></i>@x.CustomerName</div>
                    <div class="mb-2 small"><i class="bi bi-geo-alt text-primary me-2"></i>@x.DeliveryAddress</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">@Ui.Money(x.OrderTotal) <small class="text-muted fw-normal">@x.PaymentMethod.ToDisplayName()</small></span>
                        <div class="d-flex gap-2">
                            <a href="tel:@Ui.Tel(x.CustomerPhone)" class="btn btn-success btn-sm rounded-pill" aria-label="Call customer"><i class="bi bi-telephone-fill"></i></a>
                            <a asp-action="Delivery" asp-route-id="@x.Id" class="btn btn-primary btn-sm rounded-pill">Open <i class="bi bi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="tab-pane fade" id="historyTab" role="tabpanel">
        @if (Model.History.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-clock-history"></i><h5>No completed deliveries yet</h5></div>
        }
        <div class="list-group shadow-sm">
            @foreach (var x in Model.History)
            {
                <a asp-action="Delivery" asp-route-id="@x.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span><span class="fw-semibold">@x.OrderNumber</span><small class="d-block text-muted">@x.CustomerName &middot; @Ui.When(x.DeliveredAt ?? x.OrderDate)</small></span>
                    <span class="badge rounded-pill @Ui.Badge(x.Status)">@x.Status.ToDisplayName()</span>
                </a>
            }
        </div>
    </div>
</div>
