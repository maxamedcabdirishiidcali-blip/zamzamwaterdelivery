@model PagerModel
@{
    string Link(int page)
    {
        var query = Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString());
        query["page"] = page.ToString();
        return Context.Request.Path + QueryString.Create(query!);
    }
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
}
@if (Model.TotalCount > 0)
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mt-3">
        <small class="text-muted">
            Showing @((Model.Page - 1) * Model.PageSize + 1)-@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount
        </small>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)" aria-label="Previous">&laquo;</a></li>
                    @for (var p = start; p <= end; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)" aria-label="Next">&raquo;</a></li>
                </ul>
            </nav>
        }
    </div>
}
