<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var isCustomer = User.IsInRole(Roles.Customer);
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-mark.svg" alt="" width="38" height="38" />
                    <span class="brand-text">Zamzam<span class="text-primary"> Water</span></span>
                </a>
                <div class="d-flex align-items-center order-lg-last gap-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (isCustomer)
                        {
                            @await Component.InvokeAsync("CartBadge")
                        }
                        @await Component.InvokeAsync("NotificationBell")
                    }
                    <button class="navbar-toggler border-0 ms-1" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto gap-lg-2">
                        <li class="nav-item"><a class="nav-link @(controller == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Products" ? "active" : "")" asp-area="" asp-controller="Products" asp-action="Index">Products</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#how-it-works">How It Works</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#contact">Contact</a></li>
                        @if (isCustomer)
                        {
                            <li class="nav-item"><a class="nav-link @(controller == "Orders" ? "active" : "")" asp-area="" asp-controller="Orders" asp-action="Index">My Orders</a></li>
                        }
                    </ul>
                    <div class="d-flex flex-column flex-lg-row gap-2 mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light border rounded-pill dropdown-toggle w-100" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    @if (User.IsInRole(Roles.Admin))
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                                    }
                                    @if (User.IsInRole(Roles.Driver))
                                    {
                                        <li><a class="dropdown-item" asp-area="Driver" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-truck me-2"></i>Driver Dashboard</a></li>
                                    }
                                    @if (isCustomer)
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Orders" asp-action="Index"><i class="bi bi-bag-check me-2"></i>My Orders</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart3 me-2"></i>My Cart</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary rounded-pill px-4" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-primary rounded-pill px-4" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/logo-mark.svg" alt="" width="40" height="40" />
                        <span class="fs-5 fw-semibold text-white">@Company.Name</span>
                    </div>
                    <p class="text-white-50 mb-0">@Company.Tagline</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white mb-3">Shop</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-area="" asp-controller="Products" asp-action="Index">Products</a></li>
                        <li><a asp-area="" asp-controller="Cart" asp-action="Index">Cart</a></li>
                        <li><a asp-area="" asp-controller="Orders" asp-action="Index">Track Order</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white mb-3">Company</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/#how-it-works">How It Works</a></li>
                        <li><a href="/#testimonials">Testimonials</a></li>
                        <li><a href="/#contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="text-white mb-3">Contact Us</h6>
                    <ul class="list-unstyled text-white-50 small mb-0">
                        <li class="mb-2"><i class="bi bi-geo-alt me-2"></i>@Company.Address</li>
                        <li class="mb-2"><i class="bi bi-telephone me-2"></i><a class="link-light" href="tel:@Ui.Tel(Company.Phone)">@Company.Phone</a></li>
                        <li class="mb-2"><i class="bi bi-envelope me-2"></i><a class="link-light" href="mailto:@Company.Email">@Company.Email</a></li>
                        <li><i class="bi bi-clock me-2"></i>@Company.WorkingHours</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="d-flex flex-column flex-md-row justify-content-between small text-white-50">
                <span>&copy; @DateTime.Now.Year @Company.Name. All rights reserved.</span>
                <span>Pure water &middot; Fast delivery &middot; Fair prices</span>
            </div>
        </div>
    </footer>

    <partial name="_Alerts" />
    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
