@model IReadOnlyList<NotificationDto>
@{
    var unread = (int)(ViewData["Unread"] ?? 0);
}
<div class="dropdown">
    <a class="nav-link position-relative px-2" href="#" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
        <i class="bi bi-bell fs-5"></i>
        @if (unread > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@(unread > 9 ? "9+" : unread.ToString())</span>
        }
    </a>
    <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0 notification-menu">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <strong>Notifications</strong>
            @if (unread > 0)
            {
                <form asp-area="" asp-controller="Notifications" asp-action="MarkAllRead" method="post">
                    <button class="btn btn-link btn-sm p-0 text-decoration-none">Mark all read</button>
                </form>
            }
        </div>
        @if (Model.Count == 0)
        {
            <div class="p-4 text-center text-muted small">You're all caught up.</div>
        }
        @foreach (var n in Model)
        {
            <a class="dropdown-item d-flex gap-2 py-2 @(n.IsRead ? "" : "unread")" asp-area="" asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id" asp-route-orderId="@n.OrderId">
                <i class="bi @Ui.Icon(n.Type) text-primary mt-1"></i>
                <span class="text-wrap">
                    <span class="d-block fw-semibold small">@n.Title</span>
                    <span class="d-block small text-muted">@n.Message</span>
                    <span class="d-block text-muted" style="font-size:.72rem">@Ui.When(n.CreatedAt)</span>
                </span>
            </a>
        }
        <a class="dropdown-item text-center small py-2 border-top" asp-area="" asp-controller="Notifications" asp-action="Index">View all</a>
    </div>
</div>
