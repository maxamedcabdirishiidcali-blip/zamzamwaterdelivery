@model IReadOnlyList<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
    Layout = ViewData["Layout"] as string ?? "_Layout";
    var inArea = Layout != "_Layout";
}
<section class="@(inArea ? "" : "container py-5")">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="@(inArea ? "h3" : "") fw-bold mb-0"><i class="bi bi-bell text-primary me-2"></i>Notifications</h1>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllRead" method="post"><button class="btn btn-outline-primary btn-sm rounded-pill">Mark all as read</button></form>
        }
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-bell-slash"></i><h5>No notifications yet</h5></div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <a class="list-group-item list-group-item-action d-flex gap-3 p-3 @(n.IsRead ? "" : "unread")" asp-action="Open" asp-route-id="@n.Id" asp-route-orderId="@n.OrderId">
                        <span class="notif-icon"><i class="bi @Ui.Icon(n.Type)"></i></span>
                        <span class="flex-grow-1">
                            <span class="d-flex justify-content-between"><strong>@n.Title</strong><small class="text-muted text-nowrap ms-2">@Ui.When(n.CreatedAt)</small></span>
                            <span class="d-block text-muted small">@n.Message</span>
                        </span>
                    </a>
                }
            </div>
        </div>
    }
</section>
