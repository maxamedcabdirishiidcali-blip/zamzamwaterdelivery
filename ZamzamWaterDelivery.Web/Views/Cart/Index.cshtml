@model CartDto
@{
    ViewData["Title"] = "My Cart";
}
<section class="container py-5">
    <h1 class="fw-bold mb-4"><i class="bi bi-cart3 text-primary me-2"></i>My Cart</h1>

    @if (Model.IsEmpty)
    {
        <div class="empty-state">
            <i class="bi bi-cart-x"></i>
            <h5>Your cart is empty</h5>
            <p class="text-muted">Add some fresh water to get started.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary rounded-pill px-4">Browse products</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.Items)
                        {
                            <div class="list-group-item p-3 cart-row" data-item-id="@item.Id">
                                <div class="row align-items-center g-3">
                                    <div class="col-3 col-md-2">
                                        <img src="@(item.ImageUrl ?? "/images/products/bottle-20l.svg")" alt="" class="img-fluid rounded-3 bg-light-blue p-2" />
                                    </div>
                                    <div class="col-9 col-md-4">
                                        <h6 class="mb-1">@item.ProductName</h6>
                                        <small class="text-muted">@Ui.Money(item.UnitPrice) each</small>
                                        @if (!item.IsAvailable)
                                        {
                                            <div class="small text-danger"><i class="bi bi-exclamation-circle me-1"></i>Only @item.AvailableStock available</div>
                                        }
                                    </div>
                                    <div class="col-7 col-md-3">
                                        <div class="input-group input-group-sm qty-stepper">
                                            <button class="btn btn-outline-primary" type="button" data-step="-1" aria-label="Decrease"><i class="bi bi-dash"></i></button>
                                            <input type="number" class="form-control text-center qty-value" value="@item.Quantity" min="1" max="@Math.Max(item.AvailableStock, item.Quantity)" aria-label="Quantity" />
                                            <button class="btn btn-outline-primary" type="button" data-step="1" aria-label="Increase"><i class="bi bi-plus"></i></button>
                                        </div>
                                    </div>
                                    <div class="col-5 col-md-3 d-flex justify-content-end align-items-center gap-3">
                                        <strong class="line-total">@Ui.Money(item.LineTotal)</strong>
                                        <form asp-action="Remove" asp-route-id="@item.Id" method="post" data-confirm="Remove @item.ProductName from your cart?">
                                            <button class="btn btn-sm btn-outline-danger" aria-label="Remove"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex justify-content-between mt-3">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-link text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Continue shopping</a>
                    <form asp-action="Clear" method="post" data-confirm="Remove all items from your cart?">
                        <button class="btn btn-link text-danger text-decoration-none"><i class="bi bi-x-circle me-1"></i>Clear cart</button>
                    </form>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-summary">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Order summary</h5>
                        <div class="d-flex justify-content-between mb-2"><span class="text-muted">Subtotal</span><span id="cart-subtotal">@Ui.Money(Model.SubTotal)</span></div>
                        <div class="d-flex justify-content-between mb-2"><span class="text-muted">Delivery fee</span><span id="cart-delivery">@Ui.Money(Model.DeliveryFee)</span></div>
                        @if (Model.FreeDeliveryThreshold > 0)
                        {
                            <small class="text-muted d-block mb-2"><i class="bi bi-info-circle me-1"></i>Free delivery on orders over @Ui.Money(Model.FreeDeliveryThreshold)</small>
                        }
                        <hr />
                        <div class="d-flex justify-content-between fs-5 fw-bold mb-4"><span>Total</span><span id="cart-total" class="text-primary">@Ui.Money(Model.Total)</span></div>
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg w-100 rounded-pill">Proceed to checkout <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    }
</section>
