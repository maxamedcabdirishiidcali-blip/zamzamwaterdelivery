@model OrderDetailsDto
@{
    ViewData["Title"] = "Order Placed";
}
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 text-center">
            <div class="success-check mb-3"><i class="bi bi-check-lg"></i></div>
            <h1 class="fw-bold">Thank you! Your order is placed.</h1>
            <p class="text-muted">We've received your order and will confirm it shortly. You'll get a notification at every step.</p>
            <div class="card border-0 shadow-sm text-start my-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-2"><span class="text-muted">Order number</span><strong>@Model.OrderNumber</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span class="text-muted">Items</span><span>@Model.ItemCount</span></div>
                    <div class="d-flex justify-content-between mb-2"><span class="text-muted">Delivery to</span><span class="text-end">@Model.DeliveryAddress, @Model.City</span></div>
                    <div class="d-flex justify-content-between mb-2"><span class="text-muted">Preferred time</span><span>@Ui.Date(Model.PreferredDeliveryDate) &middot; @Model.PreferredTimeSlot</span></div>
                    <div class="d-flex justify-content-between mb-2"><span class="text-muted">Payment</span><span>@Model.PaymentMethod.ToDisplayName()</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fs-5 fw-bold"><span>Total</span><span class="text-primary">@Ui.Money(Model.Total)</span></div>
                </div>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4"><i class="bi bi-geo me-1"></i>Track my order</a>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">Continue shopping</a>
            </div>
        </div>
    </div>
</section>
