@model LoginDto
@{
    ViewData["Title"] = "Login";
}
<section class="auth-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="card border-0 shadow auth-card">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <img src="~/images/logo-mark.svg" alt="" width="56" height="56" class="mb-2" />
                            <h1 class="h3 fw-bold">Welcome back</h1>
                            <p class="text-muted mb-0">Log in to order water and track deliveries.</p>
                        </div>
                        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                            <div class="form-floating mb-3">
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" autofocus />
                                <label asp-for="Email"></label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Password" class="form-control" placeholder="Password" autocomplete="current-password" />
                                <label asp-for="Password"></label>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="form-check mb-4">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label"></label>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill" data-loading="Signing in...">Login</button>
                        </form>
                        <p class="text-center mt-4 mb-0 small">New to Zamzam Water? <a asp-action="Register">Create an account</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
