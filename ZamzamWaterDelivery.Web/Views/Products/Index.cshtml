@model ListViewModel<ProductDto, ProductFilter>
@{
    ViewData["Title"] = "Products";
}
<section class="page-header">
    <div class="container">
        <h1 class="fw-bold mb-1">Our Water Products</h1>
        <p class="mb-0 text-white-75">Pure, purified drinking water in every size you need.</p>
    </div>
</section>

<section class="container py-4">
    <form method="get" class="card border-0 shadow-sm p-3 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small text-muted" for="Search">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="Search" id="Search" value="@Model.Filter.Search" class="form-control" placeholder="Search bottles, cartons..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted" for="CategoryId">Category</label>
                <select name="CategoryId" id="CategoryId" class="form-select" asp-items="Model.Lookup">
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted" for="SortBy">Sort by</label>
                <select name="SortBy" id="SortBy" class="form-select">
                    <option value="">Featured</option>
                    <option value="price_asc" selected="@(Model.Filter.SortBy == "price_asc")">Price: low to high</option>
                    <option value="price_desc" selected="@(Model.Filter.SortBy == "price_desc")">Price: high to low</option>
                    <option value="name" selected="@(Model.Filter.SortBy == "name")">Name</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Filter</button>
            </div>
        </div>
    </form>

    @if (Model.Result.Items.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-droplet"></i>
            <h5>No products found</h5>
            <p class="text-muted">Try a different search or category.</p>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill">Clear filters</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Model.Result.Items)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3"><partial name="_ProductCard" model="product" /></div>
            }
        </div>
        <partial name="_Pager" model="PagerModel.From(Model.Result)" />
    }
</section>
