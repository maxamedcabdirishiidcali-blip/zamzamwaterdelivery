@model IReadOnlyList<OrderDto>
@{
    ViewData["Title"] = "My Orders";
}
<section class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <h1 class="fw-bold mb-0"><i class="bi bi-bag-check text-primary me-2"></i>My Orders</h1>
        <form asp-action="Track" method="get" class="d-flex gap-2">
            <input name="orderNumber" class="form-control" placeholder="Track by order number" aria-label="Order number" />
            <button class="btn btn-primary text-nowrap"><i class="bi bi-search me-1"></i>Track</button>
        </form>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-bag"></i>
            <h5>No orders yet</h5>
            <p class="text-muted">Your orders will appear here.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary rounded-pill px-4">Order water now</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Order #</th><th>Date</th><th class="d-none d-md-table-cell">Items</th><th>Total</th><th>Status</th><th class="d-none d-lg-table-cell">Driver</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@o.OrderNumber</td>
                                <td>@Ui.Date(o.OrderDate)</td>
                                <td class="d-none d-md-table-cell">@o.ItemCount</td>
                                <td>@Ui.Money(o.Total)</td>
                                <td><span class="badge rounded-pill @Ui.Badge(o.Status)">@o.Status.ToDisplayName()</span></td>
                                <td class="d-none d-lg-table-cell">@(o.DriverName ?? "-")</td>
                                <td class="text-end"><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary rounded-pill">Track</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
